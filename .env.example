# SQLite data location (use /app/data/rush.sqlite on Railway with a persistent volume)
SQLITE_DB_PATH=data/rush.sqlite

# Cal Poly Microsoft 365 / Entra OpenID Connect sign-in.
# Register this callback in Microsoft Entra: https://your-domain/api/auth/microsoft/callback
# Use Cal Poly's tenant ID (recommended) or its verified tenant domain.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
AUTH_APP_URL=https://your-domain
# Optional: set this if the exact callback URL must differ from AUTH_APP_URL.
MICROSOFT_REDIRECT_URI=

# Generate a long, unique random value and keep it private. It protects OAuth state
# and any optional email-code fallback sessions.
AUTH_CODE_SECRET=

# Optional legacy passwordless-email fallback through Resend. The normal sign-in
# experience uses Microsoft 365 instead.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Rush <no-reply@example.com>"

# SMS confirmation through a Twilio Verify service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
