# SQLite data location (use /app/data/rush.sqlite on Railway with a persistent volume)
SQLITE_DB_PATH=data/rush.sqlite

# Passwordless @calpoly.edu email confirmation through Resend.
# AUTH_EMAIL_FROM must be a sender address on a domain verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Rush <no-reply@example.com>"
# Generate a long, unique random value and keep it private.
AUTH_CODE_SECRET=

# SMS confirmation through a Twilio Verify service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
